# Copy to .env and fill in. Never commit .env.

NEXT_PUBLIC_SITE_URL="https://www.sopxtech.com"

# Email notifications (Nodemailer over SMTP). For Gmail, SMTP_PASSWORD is an
# App Password (Google Account > Security > 2-Step Verification > App passwords),
# not the normal account password. Without SMTP_USER/SMTP_PASSWORD the email is skipped.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
CONTACT_EMAIL="sopxtech@gmail.com"

# Google Sheets
GOOGLE_SHEETS_WEB_APP_URL=""

# Rate limiting (Upstash Redis). The Vercel Upstash integration sets these;
# without them the limiter falls back to per-instance memory.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
